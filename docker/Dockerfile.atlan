# ATLAN PATCH: Multi-stage Dockerfile with sub-path support.
# Builds the frontend and Go binary from source in a single Docker build.
# Pass --build-arg VITE_BASE_PATH=/api/capacitor/ to bake the sub-path into the React build.
# The Go server and all routes stay unchanged — Kong's strip-path:true handles the prefix.

# ── Stage 1: Build React frontend ─────────────────────────────────────────────
FROM node:20-alpine AS frontend

WORKDIR /web

COPY web/package*.json ./
RUN npm ci

COPY web/ ./

# VITE_BASE_PATH is a Node-level env var read by vite.config.mjs at build time.
# Vite bakes it into asset URLs (<script src="/api/capacitor/assets/...">) and
# exposes it as import.meta.env.BASE_URL inside the React bundle.
ARG VITE_BASE_PATH=/api/capacitor/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

RUN npm run build

# ── Stage 2: Build Go binary ───────────────────────────────────────────────────
FROM golang:1.23-alpine AS backend

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags '-s -w -extldflags "-static"' \
    -a -installsuffix cgo \
    -o /capacitor-bin \
    github.com/gimlet-io/capacitor/cmd/capacitor

# ── Stage 3: Final runtime image ──────────────────────────────────────────────
FROM alpine:3

RUN addgroup -S capacitor && adduser -S capacitor -G capacitor

ADD docker/known_hosts /etc/ssh/ssh_known_hosts

RUN mkdir /var/lib/capacitor && chown capacitor:capacitor /var/lib/capacitor

WORKDIR /capacitor

# Copy the Go binary
COPY --from=backend --chown=capacitor:capacitor /capacitor-bin capacitor

# Copy the built React app — served at runtime by the Go binary from ./web/build
COPY --from=frontend --chown=capacitor:capacitor /web/build ./web/build/

USER capacitor

EXPOSE 9000
CMD ["/capacitor/capacitor"]
